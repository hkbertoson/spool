{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Resource names predate the Spool rename; renaming the Worker or database would create new ones.
  "name": "print-queue",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "@tanstack/react-start/server-entry",
  "observability": {
    "enabled": true,
  },
  // BETTER_AUTH_URL and EMAIL_FROM are set per deployment (`wrangler secret put`), not committed.
  "keep_vars": true,
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  // Emails anyone can request for an address (reset and confirmation links), per address.
  // namespace_id is any integer not used by another rate limiter on the account.
  "ratelimits": [
    {
      "name": "EMAIL_RATE_LIMIT",
      "namespace_id": "7731",
      "simple": {
        "limit": 2,
        "period": 60
      },
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "df779c65-950c-4db2-a8a8-a17e4032fc80",
      "database_name": "print-queue",
      "migrations_dir": "migrations",
    },
  ],
}