{
  "name": "spool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-start": "^1.168.58",
    "better-auth": "^1.7.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@cloudflare/vite-plugin": "^1.60.0",
    "@oxlint/plugins": "1.85.0",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1",
    "wrangler": "^4.139.0"
  },
  "packageManager": "pnpm@12.5.1",
  "cloudflare": {
    "bindings": {
      "BETTER_AUTH_SECRET": {
        "description": "Generate a random string using `openssl rand -base64 32`."
      },
      "BETTER_AUTH_URL": {
        "description": "The URL for the Better Auth service."
      },
      "EMAIL_FROM": {
        "description": "Sender address for invites, notifications and password resets, on a domain verified with your email provider (Cloudflare Email Sending, or Resend if RESEND_API_KEY is set)."
      }
    }
  }
}
