{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "file=$(jq -r '.tool_input.file_path'); pnx oxlint --fix --no-error-on-unmatched-pattern \"$file\"; pnx oxfmt --no-error-on-unmatched-pattern \"$file\""
                    }
                ]
            }
        ]
    }
}